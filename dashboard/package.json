{
  "name": "autotrading-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@azure/msal-browser": "5.29.1",
    "@azure/msal-react": "5.8.2",
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-is": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.5",
    "openapi-typescript": "7.13.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "start": "node server/main.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:architecture": "eslint --config eslint.architecture.js . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check-types": "tsc --build --noEmit",
    "generate:api-client": "cd .. && uv run python -m tools.openapi_document dashboard/openapi.json && cd dashboard && openapi-typescript openapi.json --output src/lib/api-schema.d.ts",
    "check:api-client": "openapi-typescript openapi.json --output src/lib/api-schema.d.ts --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenarios": "bddgen && playwright test"
  },
  "engines": {
    "node": ">=24"
  }
}
